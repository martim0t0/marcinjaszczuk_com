# Copy to .env.local for local development. Both values are safe to expose
# (NEXT_PUBLIC_*) and are only used to build correct absolute/base-path URLs.

# Full site origin, no trailing slash. Used for canonical URLs, sitemap, and
# Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://marcinjaszczuk.com

# Not used — the site ships a custom domain (see public/CNAME) and is always
# served from the root. Only needed if this ever moves to a GitHub *project*
# page (https://<user>.github.io/<repo>/) without a custom domain.
NEXT_PUBLIC_BASE_PATH=
